# -----------------------------------------------------------------------------
# 1. ESTRUTURAS DE DADOS OBRIGATÓRIAS E CONSTANTES
# -----------------------------------------------------------------------------

# Tupla com as salas do laboratório (não mutável)
SALAS = ('LAB1', 'LAB2', 'LAB3')

# Tupla com os estados possíveis para os equipamentos
ESTADOS = ('operacional', 'avariado', 'em reparação')

# Lista de tipos de equipamentos permitidos
tipos = ['computador', 'monitor', 'impressora', 'router', 'switch', 'projetor']

# Dicionário principal com pré-carregamento de 6 equipamentos nas 3 salas
inventario = {
    'PC01': {
        'nome': 'desktop hp elitedesk',
        'tipo': 'computador',
        'sala': 'LAB1',
        'quantidade': 12,
        'estado': 'operacional',
    },
    'MN01': {
        'nome': 'monitor dell 24',
        'tipo': 'monitor',
        'sala': 'LAB1',
        'quantidade': 12,
        'estado': 'operacional',
    },
    'IMP01': {
        'nome': 'impressora laser brother',
        'tipo': 'impressora',
        'sala': 'LAB3',
        'quantidade': 1,
        'estado': 'avariado',
    },
    'RT01': {
        'nome': 'router cisco rv340',
        'tipo': 'router',
        'sala': 'LAB2',
        'quantidade': 2,
        'estado': 'operacional',
    },
    'SW01': {
        'nome': 'switch cisco 24 portas',
        'tipo': 'switch',
        'sala': 'LAB2',
        'quantidade': 4,
        'estado': 'avariado',
    },
    'PR01': {
        'nome': 'projetor epson e20',
        'tipo': 'projetor',
        'sala': 'LAB3',
        'quantidade': 3,
        'estado': 'operacional',
    },
}

# Construção automática da lista de reparação no arranque
lista_reparacao = []
for codigo in inventario:
    if inventario[codigo]['estado'] == 'avariado':
        lista_reparacao.append(codigo)

# Lista para guardar equipamentos reparados durante a execução
reparados = []

# Histórico de operações efetuadas no programa
historico = []

# -----------------------------------------------------------------------------
# 2. CONSTRUÇÃO DO MENU PRINCIPAL (R0)
# -----------------------------------------------------------------------------

menu = '\n' + '=' * 10 + ' GESTOR DE INVENTÁRIO ' + '=' * 10 + '\n'
menu += '1 - Listar equipamentos\n'
menu += '2 - Adicionar equipamento\n'
menu += '3 - Pesquisar equipamento\n'
menu += '4 - Alterar estado de um equipamento\n'
menu += '5 - Remover equipamento\n'
menu += '6 - Lista de reparação\n'
menu += '7 - Estatísticas\n'
menu += '8 - Histórico de operações\n'
menu += '0 - Sair\n'

# Flag para controlo da execução do ciclo principal
ativo = True

# -----------------------------------------------------------------------------
# 3. CICLO PRINCIPAL DA APLICAÇÃO
# -----------------------------------------------------------------------------

while ativo:
    print(menu)
    opcao = input('Escolha uma opção: ').strip()

    # -------------------------------------------------------------------------
    # R1 - Listar equipamentos
    # -------------------------------------------------------------------------
    if opcao == '1':
        print('\n--- LISTA DE EQUIPAMENTOS ---')

        if not inventario:
            print('O inventário está vazio. Não há equipamentos para listar.')
        else:
            codigos_ordenados = sorted(inventario.keys())

            print(
                f"{'CÓDIGO':<8} | {'NOME':<30} | {'SALA':<6} | "
                f"{'QUANTIDADE':<10} | {'ESTADO':<12}"
            )
            print('-' * 75)

            for codigo in codigos_ordenados:
                item = inventario[codigo]
                nome_formatado = item['nome'].title()
                sala = item['sala']
                qtd = f"{item['quantidade']} un."
                estado = item['estado']

                print(
                    f'{codigo:<8} | {nome_formatado:<30} | {sala:<6} | '
                    f'{qtd:<10} | {estado:<12}'
                )

            total_registos = len(inventario)
            print(f'\nTotal de registos: {total_registos}')

    # -------------------------------------------------------------------------
    # R2 - Adicionar equipamento
    # -------------------------------------------------------------------------
    elif opcao == '2':
        print('\n--- ADICIONAR EQUIPAMENTO ---')

        codigo_input = input('Introduza o código do equipamento: ')
        codigo = codigo_input.strip().upper()

        if codigo == '':
            print('Erro: O código não pode ficar vazio. A regressar ao menu.')
        elif codigo in inventario:
            print(f"Erro: O código '{codigo}' já existe no inventário.")
        else:
            nome = input('Introduza o nome/descrição: ').strip().lower()
            while nome == '':
                print('Erro: O nome não pode ficar vazio.')
                nome = input('Introduza o nome/descrição: ').strip().lower()

            print(f"Tipos aceites: {', '.join(tipos)}")
            tipo = input('Introduza o tipo: ').strip().lower()
            while tipo not in tipos:
                print(
                    f"Tipo inválido! Escolha um dos seguintes: {', '.join(tipos)}"
                )
                tipo = input('Introduza o tipo: ').strip().lower()

            sala = input('Introduza a sala (LAB1, LAB2, LAB3): ').strip().upper()
            while sala not in SALAS:
                print('Sala inválida! As salas disponíveis são: LAB1, LAB2, LAB3')
                sala = input('Introduza a sala: ').strip().upper()

            qtd_input = int(input('Introduza a quantidade: '))
            while qtd_input <= 0:
                print('Erro: A quantidade tem de ser um número maior que zero.')
                qtd_input = int(input('Introduza a quantidade: '))

            estado = 'operacional'

            inventario[codigo] = {
                'nome': nome,
                'tipo': tipo,
                'sala': sala,
                'quantidade': qtd_input,
                'estado': estado,
            }

            msg_historico = f"Adicionado equipamento {codigo} ({nome.title()}) na sala {sala}."
            historico.append(msg_historico)

            print(
                f"\nSucesso: Equipamento '{codigo}' adicionado ao inventário!"
            )

    # -------------------------------------------------------------------------
    # R3 - Pesquisar equipamento
    # -------------------------------------------------------------------------
    elif opcao == '3':
        print('\n--- PESQUISAR EQUIPAMENTO ---')
        codigo = input('Introduza o código a pesquisar: ').strip().upper()

        equipamento = inventario.get(codigo)

        if equipamento is not None:
            print(f"\nFICHA DO EQUIPAMENTO [{codigo}]")
            print('-' * 35)

            for chave, valor in equipamento.items():
                if chave == 'nome':
                    valor_exibicao = valor.title()
                else:
                    valor_exibicao = valor
                print(f"{chave.title():<12}: {valor_exibicao}")
            print('-' * 35)
        else:
            print(f"Erro: O equipamento com o código '{codigo}' não existe.")

    # -------------------------------------------------------------------------
    # R4 - Alterar estado de um equipamento
    # -------------------------------------------------------------------------
    elif opcao == '4':
        print('\n--- ALTERAR ESTADO ---')
        codigo = input('Introduza o código do equipamento: ').strip().upper()

        if codigo not in inventario:
            print(f"Erro: O equipamento com o código '{codigo}' não existe.")
        else:
            estado_atual = inventario[codigo]['estado']
            print(f"Equipamento: {codigo} | Estado atual: '{estado_atual}'")
            print(f"Estados válidos: {', '.join(ESTADOS)}")

            novo_estado = input('Introduza o novo estado: ').strip().lower()

            while novo_estado not in ESTADOS:
                print(
                    f"Estado inválido! Escolha um dos seguintes: {', '.join(ESTADOS)}"
                )
                novo_estado = input('Introduza o novo estado: ').strip().lower()

            if novo_estado == estado_atual:
                print('O novo estado é igual ao estado atual. Nenhuma alteração efetuada.')
            else:
                inventario[codigo]['estado'] = novo_estado

                if novo_estado == 'avariado':
                    if codigo not in lista_reparacao:
                        lista_reparacao.append(codigo)
                else:
                    if codigo in lista_reparacao:
                        lista_reparacao.remove(codigo)

                msg_hist = f"Estado de {codigo}: {estado_atual} -> {novo_estado}"
                historico.append(msg_hist)

                print(
                    f"Sucesso: Estado de '{codigo}' atualizado para '{novo_estado}'."
                )

    # -------------------------------------------------------------------------
    # R5 - Remover equipamento
    # -------------------------------------------------------------------------
    elif opcao == '5':
        print('\n--- REMOVER EQUIPAMENTO ---')
        codigo = input('Introduza o código do equipamento a remover: ').strip().upper()

        if codigo not in inventario:
            print(f"Erro: O equipamento com o código '{codigo}' não existe.")
        else:
            nome_eq = inventario[codigo]['nome'].title()
            confirma = input(f"Tem a certeza que deseja remover '{codigo} - {nome_eq}'? (s/n): ")
            confirma = confirma.strip().lower()

            if confirma == 's':
                # Remove do dicionario principal
                del inventario[codigo]

                # Retira todas as ocorrencias da lista de reparacao
                while codigo in lista_reparacao:
                    lista_reparacao.remove(codigo)

                msg_hist = f"Removido equipamento {codigo} ({nome_eq}) do inventário."
                historico.append(msg_hist)

                print(f"Sucesso: O equipamento '{codigo}' foi removido com sucesso.")
            else:
                print('Operação cancelada. O equipamento não foi removido.')

    # -------------------------------------------------------------------------
    # R6 - Lista de reparação
    # -------------------------------------------------------------------------
    elif opcao == '6':
        print('\n--- LISTA DE REPARAÇÃO ---')

        if not lista_reparacao:
            print('Não há equipamentos a aguardar reparação neste momento.')
        else:
            print('Equipamentos a aguardar reparação (por ordem):')
            num = 1
            for cod in lista_reparacao:
                nome_item = inventario[cod]['nome'].title()
                print(f"  {num}. {cod} - {nome_item}")
                num += 1

            proc = input('\nProcessar todas as reparações? (s/n): ').strip().lower()

            if proc == 's':
                print()
                # Processa reparações com ciclo while retirando o 1º elemento
                while lista_reparacao:
                    cod_rep = lista_reparacao.pop(0)
                    inventario[cod_rep]['estado'] = 'operacional'
                    reparados.append(cod_rep)

                    nome_rep = inventario[cod_rep]['nome'].title()
                    print(f"  A reparar {cod_rep} ({nome_rep})...")

                    msg_hist = f"Reparação concluída: {cod_rep} passou para operacional."
                    historico.append(msg_hist)

                print('\nTodas as reparações foram concluídas com sucesso!')
                print(f'Equipamentos reparados nesta sessão: {reparados}')
            else:
                print('Operação cancelada. Os equipamentos mantêm-se em reparação.')

    # -------------------------------------------------------------------------
    # R7 - Estatísticas (a implementar nas próximas etapas)
    # -------------------------------------------------------------------------
    elif opcao == '7':
        print('\nOpção 7 - Estatísticas (Em desenvolvimento)')

    # -------------------------------------------------------------------------
    # R8 - Histórico de operações
    # -------------------------------------------------------------------------
    elif opcao == '8':
        print('\n--- HISTÓRICO DE OPERAÇÕES ---')

        if not historico:
            print('Ainda não foram realizadas operações nesta sessão.')
        else:
            total_op = len(historico)
            print(f'Total de operações realizadas na sessão: {total_op}\n')

            ultimas_operacoes = historico[-5:]

            print('Últimas operações efetuadas (máximo 5):')
            num_ordem = 1
            for operacao in ultimas_operacoes:
                print(f' {num_ordem}. {operacao}')
                num_ordem += 1

    # -------------------------------------------------------------------------
    # R0 - Sair da aplicação
    # -------------------------------------------------------------------------
    elif opcao == '0':
        confirmacao = input('Tem a certeza que deseja sair? (s/n): ')
        confirmacao = confirmacao.strip().lower()

        if confirmacao == 's':
            print('\nA encerrar o Gestor de Inventário... Até breve!')
            ativo = False
        else:
            print('\nOperação cancelada. De volta ao menu principal.')

    # Mensagem de erro para opções inválidas do menu
    else:
        print('\nOpção inválida! Por favor escolha um número entre 0 e 8.')
